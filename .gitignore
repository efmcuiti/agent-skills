skills/domain-modeling/
skills/find-skills/
skills/grill-me/
skills/grill-with-docs/
skills/grilling/
skills/handoff/
skills/improve-codebase-architecture/
skills/prototype/
skills/writing-for-agents/

# Retired third-party skills, deleted upstream. Ignored so they do not
# reappear as untracked before step 4 removes them from disk.
skills/setup-matt-pocock-skills/
skills/tdd/
skills/to-issues/
skills/to-prd/
skills/write-a-skill/
skills/zoom-out/
